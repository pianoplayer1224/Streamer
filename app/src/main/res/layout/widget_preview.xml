<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the widget picker. Hand-written because Glance renders at
  runtime and has nothing to offer a chooser; without it the picker falls back to the
  app icon, which tells you nothing about what the widget does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECF4FC"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Monday 7 Sep"
        android:textColor="#10344E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#33808080" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#D7E9FA"
        android:padding="6dp">

        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="#336D85" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="09:30"
            android:textColor="#10344E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Physics"
            android:textColor="#10344E"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#D7E9FA"
        android:padding="6dp">

        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="#FC7C00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="15:30"
            android:textColor="#10344E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Keyboard"
            android:textColor="#10344E"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
